#!/usr/bin/env bash
# El host requiere Bash y Docker Compose v2. No requiere Python ni PostgreSQL.
set -Eeuo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

help() {
  cat <<'TXT'
Uso: ./main [iniciar|probar|estado|detener|logs|adquirir|diagnosticar-fuentes|evaluar|vigilancia] [opciones]
  iniciar (predeterminado)   Construye, aplica SQL, carga, valida y habilita web.
  probar                    Ejecuta pruebas unitarias y BD desechable separada.
  estado                    Muestra contenedores y salud del servicio.
  detener                   Detiene servicios; conserva volúmenes.
  logs                      Muestra logs recientes sin imprimir credenciales.
  adquirir --sources IDS --reuse IDS  Actualiza fuentes seleccionadas y conserva originales explícitos.
  diagnosticar-fuentes --source S6  Comprueba DNS, HTTPS, índice y PDF sin publicar datos.
  evaluar --request RUTA    Compara una misión y conserva la evaluación en datos/runs/evaluaciones.
  evaluar --experiment RUTA Ejecuta el lote predefinido sin seleccionar resultados favorables.
  vigilancia adquirir      Descarga IFS HRES y obstáculos OSM; conserva originales.
  vigilancia preparar      Construye la red adaptativa y carga once JSON.
  vigilancia evaluar --request RUTA | --experiment RUTA
  vigilancia extraer --dataset M5 --output datos/runs/exportados
  vigilancia cargar --file RUTA
Opciones de iniciar: --scope base|completo --mode snapshot|online --run-id UUID
El modo snapshot reconstruye la red desde originales conservados, sin consultas externas.
--mode online actualiza S1-S7 para la red aérea configurada. El alcance completo
ejecuta infraestructura y los ocho ETL de metadata/amenazas del simulador.
TXT
}
if [[ "${1:-}" == '-h' || "${1:-}" == '--help' ]]; then help; exit 0; fi
action="${1:-iniciar}"
if (($#)); then shift; fi
if [[ "$action" == vigilancia ]]; then
  command -v docker >/dev/null || { echo 'Falta Docker' >&2;exit 1; }
  docker compose --env-file .env build etl web
  docker compose --env-file .env run --rm --no-deps etl python -m core.patrol "$@"
  exit $?
fi
case "$action" in iniciar|probar|estado|detener|logs|adquirir|diagnosticar-fuentes|evaluar) ;; *) help >&2; exit 2;; esac
scope=completo;mode=snapshot;run_id='';sources='';reuse='';request='';experiment='';source=''
while (($#)); do
  case "$1" in
    --scope) [[ $# -ge 2 ]] || exit 2;scope="$2";shift 2;;
    --mode) [[ $# -ge 2 ]] || exit 2;mode="$2";shift 2;;
    --run-id) [[ $# -ge 2 ]] || exit 2;run_id="$2";shift 2;;
    --sources) [[ $# -ge 2 ]] || exit 2;sources="$2";shift 2;;
    --source) [[ $# -ge 2 ]] || exit 2;source="$2";shift 2;;
    --reuse) [[ $# -ge 2 ]] || exit 2;reuse="$2";shift 2;;
    --request) [[ $# -ge 2 ]] || exit 2;request="$2";shift 2;;
    --experiment) [[ $# -ge 2 ]] || exit 2;experiment="$2";shift 2;;
    *) echo "Opción desconocida: $1" >&2;exit 2;;
  esac
done
[[ "$scope" == base || "$scope" == completo ]] || { echo 'scope inválido' >&2;exit 2; }
[[ "$mode" == snapshot || "$mode" == online ]] || { echo 'mode inválido' >&2;exit 2; }
command -v docker >/dev/null || { echo 'Falta Docker. Instalar Docker Desktop (con WSL2 en Windows) o Docker Engine + Compose v2.' >&2;exit 1; }
docker compose version >/dev/null || { echo 'Falta Docker Compose v2.' >&2;exit 1; }
docker info >/dev/null 2>&1 || { echo 'Docker no está disponible: iniciar Docker Desktop o el servicio Docker.' >&2;exit 1; }
if [[ ! -e .env ]]; then
  umask 077
  db_pass="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  web_pass="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  { echo 'POSTGRES_DB=ruteo';echo 'POSTGRES_USER=postgres';
    printf 'POSTGRES_PASSWORD=%s\nWEB_DB_PASSWORD=%s\nWEB_PORT=8080\n' "$db_pass" "$web_pass"; } > .env
  unset db_pass web_pass
fi
compose=(docker compose --env-file .env)
export BUILD_COMMIT="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
"${compose[@]}" config --quiet
case "$action" in
  diagnosticar-fuentes)
    [[ "$source" == S6 ]] || { echo 'Indicar --source S6' >&2;exit 2; }
    "${compose[@]}" build etl
    "${compose[@]}" run --rm --no-deps etl python -m core.aip_acquisition --source "$source"
    ;;
  adquirir)
    "${compose[@]}" build etl
    args=(python -m Infraestructura.descargar_aereo)
    [[ -z "$sources" ]] || args+=(--sources "$sources")
    [[ -z "$reuse" ]] || args+=(--reuse "$reuse")
    "${compose[@]}" run --rm --no-deps etl "${args[@]}"
    ;;
  evaluar)
    [[ -n "$request" && -z "$experiment" || -z "$request" && -n "$experiment" ]] || { echo 'Indicar exactamente una opción: --request o --experiment' >&2;exit 2; }
    # Relativo al WORKDIR /app: evita conversión MSYS de rutas Linux en Git Bash.
    args=(python -m core.mission_evaluation --output datos/runs/evaluaciones)
    [[ -z "$request" ]] || args+=(--request "$request")
    [[ -z "$experiment" ]] || args+=(--experiment "$experiment")
    "${compose[@]}" run --rm --no-deps etl "${args[@]}"
    ;;
  iniciar)
    mkdir -p datos/runs
    "${compose[@]}" build etl web
    "${compose[@]}" run --rm --no-deps etl python -m core.pipeline preflight --scope "$scope" --mode "$mode"
    "${compose[@]}" up -d --wait db
    args=(python -m core.pipeline run --scope "$scope" --mode "$mode")
    [[ -z "$run_id" ]] || args+=(--run-id "$run_id")
    # Una ejecución one-shot real; un fallo detiene main antes de habilitar web.
    "${compose[@]}" run --rm --no-deps etl "${args[@]}"
    if [[ -f datos/entrada/vigilancia/manifest.json ]]; then
      "${compose[@]}" run --rm --no-deps etl python -m core.patrol preparar
    fi
    "${compose[@]}" up -d --no-deps --wait web
    "${compose[@]}" exec -T web python -m core.health --scope "$scope"
    printf 'Aplicación de ruteo: http://%s\n' "$("${compose[@]}" port web 8000)"
    ;;
  probar)
    # Cada corrida necesita otro tmpfs: la BD no puede reutilizar un run listo
    # cuyos JSON pertenecían al contenedor de pruebas anterior.
    docker compose --env-file .env -f compose.test.yaml up --build --force-recreate --abort-on-container-exit --exit-code-from tests
    ;;
  estado)
    "${compose[@]}" ps
    "${compose[@]}" exec -T web python -m core.health
    ;;
  detener) "${compose[@]}" down;;
  logs) "${compose[@]}" logs --tail 100;;
esac
