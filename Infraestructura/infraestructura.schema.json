{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","run_id","dataset_id","dataset_key","source_id","observed_at","extracted_at","crs","analysis_srid","input_hash","lineage","extraction_mode","nodes","edges"],
  "properties": {
    "schema_version": {"const":"1.0"}, "run_id":{"type":"string","format":"uuid"},
    "dataset_id":{"type":"string","format":"uuid"}, "dataset_key":{"const":"I"},
    "source_id":{"const":"DERIVED_GRAPH"}, "observed_at":{"type":"string"}, "extracted_at":{"type":"string"},
    "crs":{"const":"EPSG:4326"}, "analysis_srid":{"const":32719},
    "input_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}, "lineage":{"type":"object"},
    "extraction_mode":{"enum":["snapshot","online"]},
    "nodes":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/node"}},
    "edges":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edge"}}
  },
  "$defs": {
    "id":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "coords":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
    "node":{"type":"object","additionalProperties":false,
      "required":["id","natural_key","kind","source_record_id","geometry"],
      "properties":{"id":{"$ref":"#/$defs/id"},"natural_key":{"type":"string","minLength":1},
        "kind":{"enum":["vigilancia","base_candidata"]},"source_record_id":{"type":["string","null"]},
        "geometry":{"type":"object","additionalProperties":false,"required":["type","coordinates"],
          "properties":{"type":{"const":"Point"},"coordinates":{"$ref":"#/$defs/coords"}}}}},
    "edge":{"type":"object","additionalProperties":false,
      "required":["id","natural_key","source","target","physical_key","geometry"],
      "properties":{"id":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/id"},
        "natural_key":{"type":"string","minLength":1},"physical_key":{"type":"string","minLength":1},
        "geometry":{"type":"object","additionalProperties":false,"required":["type","coordinates"],
          "properties":{"type":{"const":"LineString"},"coordinates":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/coords"}}}}}}
  }
}
